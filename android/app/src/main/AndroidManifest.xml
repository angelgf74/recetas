<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Recetas">

        <!--
            allowBackup="false" a propósito: la copia de seguridad automática se
            llevaría el almacén cifrado a los servidores de Google, y con él el
            token de sesión.
        -->

        <!--
            Identificador de aplicación de AdMob. Va aquí y no en el código porque
            el SDK lo lee del manifiesto al arrancar; si falta, la aplicación
            revienta nada más iniciar el SDK.

            No es un secreto: acaba dentro del APK y cualquiera puede leerlo.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8600791204816041~1145017083" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Recetas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Enlaces de aplicación: el enlace del correo del alta o del
                restablecimiento abre la aplicación si está instalada, y si no,
                sigue funcionando en la web.

                autoVerify exige que el dominio publique /.well-known/assetlinks.json
                con la huella del certificado de firma. Está publicado con la de
                DEPURACIÓN; al firmar para publicar hay que añadir la suya, o los
                enlaces dejarán de abrir la aplicación instalada desde la tienda.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="recetas.angelgf.com.es" />
                <data android:pathPrefix="/registro/completar" />
                <data android:pathPrefix="/contrasena/nueva" />
            </intent-filter>
        </activity>
    </application>

</manifest>
