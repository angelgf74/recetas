@*
    Iconos en SVG en línea.

    No se usa una biblioteca de iconos: serían kilobytes descargados para cinco
    formas, y una fuente o una hoja externa chocaría con la política de seguridad
    de contenido, que solo admite recursos del propio origen.

    Todos usan `currentColor`, así que heredan el color del botón que los
    contiene y no hay que mantener una paleta aparte.

    El SVG lleva aria-hidden porque el significado lo aporta el aria-label del
    botón: si el icono también se anunciara, un lector de pantalla lo leería dos
    veces.
*@

<svg class="icono" viewBox="0 0 24 24" width="22" height="22" fill="none"
     stroke="currentColor" stroke-width="2" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Nombre)
    {
        case "lapiz":
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
            break;

        case "camara":
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z" />
            <circle cx="12" cy="13" r="4" />
            break;

        case "compartir":
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
            break;

        case "no-compartir":
            <circle cx="18" cy="5" r="3" />
            <circle cx="6" cy="12" r="3" />
            <circle cx="18" cy="19" r="3" />
            <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
            @* La barra que niega la acción: es lo que distingue "dejar de
               compartir" de "compartir" cuando no hay texto que lo diga. *@
            <path d="M3 21 21 3" />
            break;

        @* La olla del icono de la aplicación, redibujada a trazo para que case con
           el resto de esta hoja. Marca el hueco de una receta sin foto. *@
        case "olla":
            <path d="M12 3v1.5" />
            <path d="M4 7h16" />
            <path d="M5.5 10h13v7a3 3 0 0 1-3 3h-7a3 3 0 0 1-3-3Z" />
            <path d="M5.5 11.5h-2M18.5 11.5h2" />
            break;

        case "papelera":
            <path d="M3 6h18" />
            <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
            <path d="M10 11v6M14 11v6" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Nombre { get; set; } = string.Empty;
}
