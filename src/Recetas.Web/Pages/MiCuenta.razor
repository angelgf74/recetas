@page "/mi-cuenta"
@using Recetas.Contratos.Sesiones
@using Recetas.Web.Componentes
@using Recetas.Web.Servicios
@inject ClienteDeApi Api
@inject EstadoDeSesion Sesion
@inject NavigationManager Navegacion
@inject IJSRuntime Js

<PageTitle>Mi cuenta · Recetas</PageTitle>

<RutaProtegida>
    <h1>Mi cuenta</h1>

    @if (_cargando)
    {
        <p class="ayuda">Cargando…</p>
    }
    else if (_identidad is null)
    {
        <div class="aviso aviso-error" role="alert">
            @(_resultado?.Mensaje ?? "No se han podido cargar tus datos.")
        </div>
    }
    else
    {
        <p>Has iniciado sesión como <strong>@_identidad.Correo</strong>.</p>

        @if (_aviso is not null)
        {
            <div class="aviso aviso-error" role="alert">@_aviso.Mensaje</div>
        }

        @*
            Antes de la zona de baja, no después: quien vaya a irse debería
            encontrarse primero la forma de llevarse sus cosas.
        *@
        <section>
            <h2>Descargar mis datos</h2>

            <p>
                Un archivo con <strong>todas tus recetas</strong> —ingredientes, elaboración
                y raciones— y <strong>tus fotos</strong> tal como las subiste. También te dice
                cuáles habías compartido.
            </p>

            <p class="ayuda">
                Se descarga en formato <code>.zip</code>. Dentro hay un archivo de texto que
                explica qué es cada cosa. Ojo: lleva tus fotos y tu correo, así que guárdalo
                donde guardarías cualquier cosa personal.
            </p>

            @*
                Botón y no enlace, aunque un enlace sería más simple.

                Una descarga iniciada por el navegador no pasa por el manejador
                que añade la cabecera de autorización, así que un `<a href>`
                obligaría a meter el testigo de sesión en la dirección. Ahí
                acabaría en los registros del servidor y en el historial del
                navegador, que es exactamente lo que `tech-stack.md` prohíbe.

                Así, la petición la hace el cliente autenticado y el archivo se
                entrega al navegador ya descargado.
            *@
            <button type="button" class="boton boton-secundario"
                    disabled="@_descargando" @onclick="DescargarAsync">
                @(_descargando ? "Preparando el archivo…" : "Descargar mis datos")
            </button>
        </section>

        <section>
            <h2>Cambiar mi contraseña</h2>

            @if (_avisoDeContrasena is not null)
            {
                <div class="aviso @(_avisoDeContrasena.Correcta ? "aviso-exito" : "aviso-error")" role="alert">
                    @_avisoDeContrasena.Mensaje
                </div>
            }

            <label class="campo">
                <span>Contraseña actual</span>
                <input type="password" @bind="_contrasenaActual" autocomplete="current-password" />
            </label>

            <label class="campo">
                <span>Contraseña nueva</span>
                <input type="password" @bind="_contrasenaNueva" autocomplete="new-password" />
                <span class="ayuda">Al menos 12 caracteres.</span>
            </label>

            <button type="button" class="boton boton-secundario"
                    disabled="@_cambiandoContrasena" @onclick="CambiarContrasenaAsync">
                @(_cambiandoContrasena ? "Cambiando…" : "Cambiar contraseña")
            </button>
        </section>

        <section class="zona-peligrosa">
            <h2>Borrar mi cuenta</h2>

            @*
                Se dice qué se pierde con números concretos. "Esta acción es
                irreversible" se lee en todas partes y no frena a nadie; "se
                borrarán 23 recetas y 41 fotos" sí frena a quien se ha
                equivocado de botón.
            *@
            <p>
                Se borrará tu cuenta y todo lo que tienes dentro:
                <strong>@Recuento(_identidad.Recetas, "receta", "recetas")</strong>
                y <strong>@Recuento(_identidad.Fotos, "foto", "fotos")</strong>.
                Las que hayas compartido dejarán de verlas los demás.
            </p>

            <p class="ayuda">
                No se puede deshacer y no hay periodo de gracia. Si algún día quieres volver,
                podrás crear una cuenta nueva con este mismo correo, pero vacía.
            </p>

            <label class="campo">
                <span>Escribe tu contraseña para confirmar</span>
                <input type="password" @bind="_contrasena" autocomplete="current-password" />
            </label>

            <Confirmacion Texto="Borrar mi cuenta"
                          Pregunta="¿Seguro? Se borrarán tu cuenta, tus recetas y tus fotos. No se puede deshacer."
                          AlConfirmar="BorrarAsync" />
        </section>
    }
</RutaProtegida>

@code {
    private RespuestaDeIdentidad? _identidad;
    private ResultadoDeLlamada? _resultado;
    private ResultadoDeLlamada? _aviso;
    private bool _cargando = true;
    private bool _descargando;
    private string _contrasena = string.Empty;

    private string _contrasenaActual = string.Empty;
    private string _contrasenaNueva = string.Empty;
    private bool _cambiandoContrasena;
    private ResultadoDeLlamada? _avisoDeContrasena;

    private async Task DescargarAsync()
    {
        _descargando = true;
        _aviso = null;

        try
        {
            var (resultado, contenido) = await Api.DescargarMisDatosAsync();

            if (!resultado.Correcta || contenido is null)
            {
                _aviso = resultado;
                return;
            }

            using var referencia = new DotNetStreamReference(contenido);

            await Js.InvokeVoidAsync(
                "descargarArchivo",
                $"recetas-{DateTime.Now:yyyy-MM-dd}.zip",
                referencia);
        }
        finally
        {
            _descargando = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        (_resultado, _identidad) = await Api.ObtenerIdentidadAsync();
        _cargando = false;
    }

    private static string Recuento(int cuantas, string singular, string plural) =>
        cuantas == 1 ? $"1 {singular}" : $"{cuantas} {plural}";

    private async Task CambiarContrasenaAsync()
    {
        _cambiandoContrasena = true;
        _avisoDeContrasena = null;

        var resultado = await Api.CambiarContrasenaAsync(_contrasenaActual, _contrasenaNueva);

        if (resultado.Correcta)
        {
            // Se limpian los dos campos: dejar la actual en pantalla sería
            // conservar una credencial que ya no hace falta ver.
            _contrasenaActual = string.Empty;
            _contrasenaNueva = string.Empty;
            _avisoDeContrasena = ResultadoDeLlamada.Correcto("Contraseña cambiada.");
        }
        else
        {
            _avisoDeContrasena = resultado;
        }

        _cambiandoContrasena = false;
    }

    private async Task BorrarAsync()
    {
        if (string.IsNullOrEmpty(_contrasena))
        {
            _aviso = ResultadoDeLlamada.Fallido("Escribe tu contraseña para confirmar.");
            return;
        }

        var resultado = await Api.BorrarMiCuentaAsync(_contrasena);

        if (!resultado.Correcta)
        {
            _aviso = resultado;
            return;
        }

        // La sesión que queda apunta a una cuenta que ya no existe: el token sigue
        // firmado hasta que caduque, pero no queda nada suyo que leer.
        await Sesion.CerrarAsync();
        Navegacion.NavigateTo("/", forceLoad: true);
    }
}
