@page "/recetas/{Id:guid}"
@using Recetas.Contratos.Moderacion
@using Recetas.Contratos.Recetas
@using Recetas.Web.Componentes
@using Recetas.Web.Servicios
@inject ClienteDeApi Api
@inject NavigationManager Navegacion

<PageTitle>@(_receta?.Nombre ?? "Receta") · Recetas</PageTitle>

<RutaProtegida>
    @if (_cargando)
    {
        <p class="ayuda">Cargando…</p>
    }
    else if (_receta is null)
    {
        <div class="aviso aviso-error" role="alert">
            @(_resultado?.Mensaje ?? "No se ha encontrado esa receta.")
        </div>
        <p><a href="/recetas">Volver a mi recetario</a></p>
    }
    else
    {
        <article class="receta">
            <header>
                <h1>@_receta.Nombre</h1>
                <p class="meta">
                    @Etiquetas.DeTipo(_receta.TipoDePlato)
                    @if (_receta.Visibilidad == "Publica")
                    {
                        <span class="marca marca-publica">Publicada</span>
                    }
                    else if (EsMia)
                    {
                        <span class="marca">Privada</span>
                    }
                </p>
            </header>

            @if (_aviso is not null)
            {
                <div class="aviso @(_aviso.Correcta ? "aviso-exito" : "aviso-error")" role="alert">
                    @_aviso.Mensaje
                </div>
            }

            @if (_receta.Fotos.Count > 0)
            {
                <section class="fotos">
                    @foreach (var foto in _receta.Fotos)
                    {
                        <figure>
                            <FotoDeReceta RecetaId="_receta.Id" FotoId="foto.Id" />
                            @if (EsMia)
                            {
                                <figcaption>
                                    <Confirmacion Texto="Borrar foto"
                                                  Icono="papelera"
                                                  Pregunta="¿Borrar esta foto? No se puede deshacer."
                                                  AlConfirmar="() => BorrarFotoAsync(foto.Id)" />
                                </figcaption>
                            }
                        </figure>
                    }
                </section>
            }

            <section>
                <h2>Ingredientes</h2>

                @if (_receta.Raciones is { } raciones)
                {
                    <div class="comensales">
                        <label for="comensales">Para</label>
                        <input id="comensales" type="number" min="1" max="100"
                               value="@_racionesMostradas"
                               @onchange="CambiarRacionesAsync"
                               disabled="@_ajustando" />
                        <span>@(_racionesMostradas == 1 ? "ración" : "raciones")</span>

                        @if (_racionesMostradas != raciones)
                        {
                            <button type="button" class="boton-enlace" @onclick="() => AjustarAsync(raciones)">
                                Volver a @raciones
                            </button>
                        }
                    </div>

                    @if (_racionesMostradas != raciones)
                    {
                        @* Que quede claro que esto no es lo que hay guardado: la
                           elaboración sigue mencionando las cantidades originales. *@
                        <p class="ayuda" role="status">
                            Cantidades ajustadas. La receta está guardada para @raciones
                            @(raciones == 1 ? "ración" : "raciones"), y los pasos siguen
                            citando esas cifras.
                        </p>
                    }
                }

                <ul class="ingredientes-lista">
                    @foreach (var linea in _receta.Ingredientes)
                    {
                        <li>
                            <span class="cantidad">
                                @Etiquetas.DeCantidad(linea.Cantidad) @Etiquetas.DeUnidad(linea.Unidad, linea.Cantidad)
                            </span>
                            <span class="ingrediente-nombre">@linea.Nombre</span>
                        </li>
                    }
                </ul>
            </section>

            <section>
                <h2>Elaboración</h2>
                @* Un párrafo por línea: la API guarda la elaboración como texto y
                   partir en pasos es decisión de presentación. *@
                @foreach (var paso in _receta.Elaboracion.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    <p class="paso">@paso.Trim()</p>
                }
            </section>

            @if (EsMia)
            {
                @*
                    Acciones como iconos. Cada botón lleva `title` para que al
                    pasar el ratón se vea qué hace, y `aria-label` para que un
                    lector de pantalla lo anuncie: sin texto visible, esas dos
                    cosas son lo único que da significado al botón.
                *@
                <section class="acciones">
                    <h2 class="solo-lectores">Acciones</h2>

                    <div class="acciones-fila">
                        <a class="boton-accion" href="@($"/recetas/{Id}/editar")"
                           title="Editar receta" aria-label="Editar receta">
                            <Icono Nombre="lapiz" />
                        </a>

                        <label class="boton-accion subir-foto"
                               title="@(_subiendoFoto ? "Subiendo la foto…" : "Añadir foto")"
                               aria-label="Añadir foto">
                            <Icono Nombre="camara" />
                            <InputFile OnChange="SubirFotoAsync" accept="image/*" disabled="@_subiendoFoto" />
                        </label>

                        @if (_receta.Visibilidad == "Publica")
                        {
                            <button type="button" class="boton-accion boton-accion-activo"
                                    title="Dejar de compartir" aria-label="Dejar de compartir"
                                    @onclick="DespublicarAsync">
                                <Icono Nombre="no-compartir" />
                            </button>
                        }
                        else
                        {
                            <button type="button" class="boton-accion"
                                    title="Compartir receta" aria-label="Compartir receta"
                                    @onclick="PublicarAsync">
                                <Icono Nombre="compartir" />
                            </button>
                        }

                        <Confirmacion Texto="Borrar receta"
                                      Icono="papelera"
                                      Pregunta="¿Borrar esta receta y sus fotos? No se puede deshacer."
                                      AlConfirmar="BorrarRecetaAsync" />
                    </div>
                </section>
            }
            else
            {
                @* Receta ajena publicada: se lee, no se toca. La autorización real
                   está en el servidor; esto solo evita ofrecer lo que va a fallar. *@
                <p class="ayuda">Esta receta la ha compartido otra persona.</p>

                <section class="denuncia">
                    @if (_denunciada)
                    {
                        @* Ya no se ofrece denunciar otra vez: la segunda no haría
                           nada y repetirla solo transmite que la primera no valió. *@
                        <p class="ayuda" role="status">
                            Gracias. Hemos recibido tu aviso y lo revisaremos.
                        </p>
                    }
                    else if (!_denunciando)
                    {
                        <button type="button" class="boton-enlace" @onclick="() => _denunciando = true">
                            Denunciar esta receta
                        </button>
                    }
                    else
                    {
                        <h2 class="denuncia-titulo">Denunciar esta receta</h2>
                        <p class="ayuda">
                            Cuéntanos qué pasa y la revisaremos. El autor no sabrá quién ha avisado.
                        </p>

                        <label for="motivo-denuncia">Motivo</label>
                        <select id="motivo-denuncia" @bind="_motivo">
                            @foreach (var (valor, texto) in MotivosDeDenuncia)
                            {
                                <option value="@valor">@texto</option>
                            }
                        </select>

                        <label for="comentario-denuncia">Explicación (opcional)</label>
                        <textarea id="comentario-denuncia" rows="3"
                                  maxlength="@PeticionDeDenuncia.LongitudMaximaDelComentario"
                                  @bind="_comentario"></textarea>

                        <div class="acciones-fila">
                            <button type="button" class="boton" disabled="@_enviandoDenuncia"
                                    @onclick="DenunciarAsync">
                                @(_enviandoDenuncia ? "Enviando…" : "Enviar denuncia")
                            </button>

                            <button type="button" class="boton-enlace" disabled="@_enviandoDenuncia"
                                    @onclick="() => _denunciando = false">
                                Cancelar
                            </button>
                        </div>
                    }
                </section>
            }
        </article>
    }
</RutaProtegida>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private RespuestaDeReceta? _receta;
    private ResultadoDeLlamada? _resultado;
    private ResultadoDeLlamada? _aviso;
    private bool _cargando = true;
    private bool _subiendoFoto;
    private bool _ajustando;

    /// <summary>
    /// Raciones que representan las cantidades en pantalla. Lo dice la respuesta, no
    /// se deduce de lo que se pidió.
    /// </summary>
    private int? _racionesMostradas;

    /// <summary>Lo dice la propia respuesta: una sola llamada para pintar la ficha.</summary>
    private bool EsMia => _receta?.EsMia == true;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _aviso = null;

        (_resultado, _receta) = await Api.ObtenerRecetaAsync(Id);
        _racionesMostradas = _receta?.RacionesMostradas;

        _cargando = false;
    }

    /// <summary>
    /// Vuelve a pedir la receta con otro número de comensales.
    /// </summary>
    /// <remarks>
    /// Se pide al servidor en vez de multiplicar aquí: el redondeo a cantidades
    /// medibles es una regla de negocio, y hacerlo en el navegador la dejaría fuera
    /// del alcance de Android.
    /// <para>
    /// Se parte <b>siempre de la receta guardada</b>, nunca de lo ya mostrado:
    /// encadenar escalados acumularía el error de cada redondeo.
    /// </para>
    /// </remarks>
    private async Task AjustarAsync(int raciones)
    {
        if (raciones is < 1 or > 100)
        {
            return;
        }

        _ajustando = true;

        var (resultado, receta) = await Api.ObtenerRecetaAsync(Id, raciones);

        if (receta is not null)
        {
            _receta = receta;
            _racionesMostradas = receta.RacionesMostradas;
        }
        else
        {
            _aviso = resultado;
        }

        _ajustando = false;
    }

    private Task CambiarRacionesAsync(ChangeEventArgs argumentos) =>
        int.TryParse(argumentos.Value?.ToString(), out var raciones)
            ? AjustarAsync(raciones)
            : Task.CompletedTask;

    private async Task RecargarAsync()
    {
        // Recargar tras publicar, subir foto o borrarla vuelve a las cantidades
        // guardadas: esas acciones no tienen nada que ver con el ajuste.
        (_resultado, _receta) = await Api.ObtenerRecetaAsync(Id);
        _racionesMostradas = _receta?.RacionesMostradas;
    }

    private async Task PublicarAsync()
    {
        _aviso = await Api.PublicarAsync(Id);

        if (_aviso.Correcta)
        {
            _aviso = ResultadoDeLlamada.Correcto("Receta compartida: ya pueden verla otros usuarios.");
            await RecargarAsync();
        }
    }

    private async Task DespublicarAsync()
    {
        _aviso = await Api.DespublicarAsync(Id);

        if (_aviso.Correcta)
        {
            _aviso = ResultadoDeLlamada.Correcto("Receta retirada: vuelve a ser solo tuya.");
            await RecargarAsync();
        }
    }

    private async Task SubirFotoAsync(InputFileChangeEventArgs argumentos)
    {
        _subiendoFoto = true;
        _aviso = null;

        var archivo = argumentos.File;

        // El tope debe ir por encima del de la API (8 MB) para que sea el servidor
        // quien decida; aquí solo se evita cargar en memoria algo desmesurado.
        await using var contenido = archivo.OpenReadStream(maxAllowedSize: 12 * 1024 * 1024);

        _aviso = await Api.SubirFotoAsync(Id, contenido);

        if (_aviso.Correcta)
        {
            _aviso = ResultadoDeLlamada.Correcto("Foto añadida.");
            await RecargarAsync();
        }

        _subiendoFoto = false;
    }

    private async Task BorrarFotoAsync(Guid fotoId)
    {
        _aviso = await Api.BorrarFotoAsync(Id, fotoId);

        if (_aviso.Correcta)
        {
            _aviso = null;
            await RecargarAsync();
        }
    }

    private async Task BorrarRecetaAsync()
    {
        var resultado = await Api.BorrarRecetaAsync(Id);

        if (resultado.Correcta)
        {
            Navegacion.NavigateTo("/recetas");
        }
        else
        {
            _aviso = resultado;
        }
    }

    // ------------------------------------------------------------- Denuncias

    /// <summary>
    /// Los valores son los del enumerado del dominio y el texto es lo que lee el
    /// usuario. Se envía el valor, nunca el texto: cambiar la redacción no debe
    /// cambiar bajo qué motivo se archiva la denuncia.
    /// </summary>
    private static readonly (string Valor, string Texto)[] MotivosDeDenuncia =
    [
        ("NoEsUnaReceta", "No es una receta"),
        ("Ofensivo", "Contenido ofensivo o de odio"),
        ("Sexual", "Contenido sexual"),
        ("Violento", "Contenido violento"),
        ("Spam", "Spam o publicidad"),
        ("Derechos", "Copia contenido de otra persona"),
        ("Otro", "Otro motivo")
    ];

    private bool _denunciando;
    private bool _enviandoDenuncia;
    private bool _denunciada;
    private string _motivo = "NoEsUnaReceta";
    private string? _comentario;

    private async Task DenunciarAsync()
    {
        _enviandoDenuncia = true;
        _aviso = null;

        var resultado = await Api.DenunciarAsync(Id, _motivo, _comentario);

        if (resultado.Correcta)
        {
            _denunciando = false;
            _denunciada = true;
            _comentario = null;
        }
        else
        {
            _aviso = resultado;
        }

        _enviandoDenuncia = false;
    }
}
